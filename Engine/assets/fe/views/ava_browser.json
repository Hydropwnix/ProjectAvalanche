  "view_symbol": {"symbol": "AvaBrowser"},
  "logic": {
    "base": "fe_view",
    "sd": {"scale": 0.79},
    "data": [
      "ava_browser", "ava_browser_rows", "ava_browser_rows_index", "ava_browser_details", "ava_browser_drop",
      "ava_browser_window"
    ],
    "texts": [
      {"target": "txtTabs", "data": "ava_browser", "field": "tabs", "html": true},
      {"target": "txtColName", "data": "ava_browser", "field": "colName"},
      {"target": "txtColMode", "data": "ava_browser", "field": "colMode"},
      {"target": "txtColDrop", "data": "ava_browser", "field": "colDrop"},
      {"target": "txtColDownload", "data": "ava_browser", "field": "colDownload", "fit": "shrink"},
      {"target": "txtColPlayers", "data": "ava_browser", "field": "colPlayers", "fit": "shrink"},
      {"target": "txtColPing", "data": "ava_browser", "field": "colPing"},
      {"target": "txtEmpty", "data": "ava_browser", "field": "empty"},
      {"target": "txtStatus", "data": "ava_browser", "field": "status", "fit": "shrink"},
      {"target": "txtPingHelp", "data": "ava_browser", "field": "pingHelp"},
      {"target": "mcDetails.txtName", "data": "ava_browser_details", "field": "name", "fit": "shrink"},
      {"target": "mcDetails.txtAddress", "data": "ava_browser_details", "field": "address", "fit": "shrink"},
      {"target": "mcDetails.txtAbout", "data": "ava_browser_details", "field": "about", "fit": "shrink"},
      {"target": "mcDetails.txtRules", "data": "ava_browser_details", "field": "rules", "fit": "shrink"},
      {"target": "mcDetails.txtPlayers", "data": "ava_browser_details", "field": "players",
        "fit": {"items": "playerNames", "more": "playersMore", "separator": ", "}}
    ],
    "visibles": [{"target": "mcDetails", "data": "ava_browser_details", "field": "bShown"}],
    "images": [{"target": "mcDetails.mcIcon", "data": "ava_browser_details", "field": "strIcon"}],
    "menus": [
      {"target": "mcRows", "rows": 9, "cell_width": 730, "cell_height": 36, "spacing": 2, "wrap": false,
        "data": "ava_browser_rows", "index": "ava_browser_rows_index", "cell": "AvaBrowserRow"}
    ],
    "paging": {"menu": "mcRows", "setup": "A_AvaBrowserSetup"},
    "scrollbars": [{"target": "mcScrollBar", "menu": "mcRows", "length": 340, "window": "ava_browser_window"}],
    "drop_panels": [{"target": "mcDrop", "data": "ava_browser_drop"}],
    "panels": [
      {"target": "mcTablePanel", "width": 746, "height": 378, "dimmer": 60},
      {"target": "mcDetailsPanel", "width": 364, "height": 378, "dimmer": 60}
    ],
    "on_enter": {"clear_inputs": true},
    "callouts": {"target": "mcCallouts", "buttons": [
      {"icon": "CALLOUT_ADVANCE", "label": "TXT_AVA_BROWSER_CONNECT"},
      {"icon": "CALLOUT_BACK", "label": "TXT_AVA_BROWSER_BACK"},
      {"icon": "CALLOUT_FACE_BUTTON_TERTIARY", "label": "TXT_AVA_BROWSER_FILTERS"},
      {"icon": "CALLOUT_FACE_BUTTON_QUATERNARY", "label": "TXT_AVA_BROWSER_FAVOURITE"},
      {"icon": "CALLOUT_R3", "label": "TXT_AVA_BROWSER_SEARCH"},
      {"icon": "CALLOUT_SELECT", "label": "TXT_AVA_BROWSER_REFRESH"},
      {"icon": "CALLOUT_L2", "label": "TXT_AVA_BROWSER_PAGE"},
      {"icon": "CALLOUT_START", "label": "TXT_AVA_BROWSER_DIRECT"}
    ]},
    "inputs": [
      {"key": "DPAD_UP", "action": "A_AvaBrowserRequestData", "param": -1},
      {"key": "LAS_UP", "action": "A_AvaBrowserRequestData", "param": -1},
      {"key": "DPAD_DOWN", "action": "A_AvaBrowserRequestData", "param": 1},
      {"key": "LAS_DOWN", "action": "A_AvaBrowserRequestData", "param": 1},
      {"key": "LEFT_TRIGGER", "action": "A_AvaBrowserPage", "param": -1, "sound": "menu_highlight"},
      {"key": "RIGHT_TRIGGER", "action": "A_AvaBrowserPage", "param": 1, "sound": "menu_highlight"},
      {"key": "LEFT_BUMPER", "action": "A_AvaBrowserTab", "param": -1, "sound": "menu_highlight"},
      {"key": "RIGHT_BUMPER", "action": "A_AvaBrowserTab", "param": 1, "sound": "menu_highlight"},
      {"key": "ADVANCE", "action": "A_AvaBrowserConnect", "sound": "menu_select"},
      {"key": "BACK", "action": "A_AvaBrowserBack", "sound": "menu_back"},
      {"key": "DIGITAL_FOUR", "action": "A_AvaBrowserFilters", "sound": "button_press_select"},
      {"key": "DIGITAL_THREE", "action": "A_AvaBrowserFavourite", "sound": "button_press_select"},
      {"key": "RAS", "action": "A_AvaBrowserSearch", "sound": "button_press_select"},
      {"key": "SELECT", "action": "A_AvaBrowserRefresh", "sound": "button_press_select"},
      {"key": "START", "action": "A_AvaBrowserDirect", "sound": "menu_select"},
      {"key": "DPAD_LEFT", "take": true},
      {"key": "DPAD_RIGHT", "take": true},
      {"key": "LAS_LEFT", "take": true},
      {"key": "LAS_RIGHT", "take": true}
    ]
  }
}
